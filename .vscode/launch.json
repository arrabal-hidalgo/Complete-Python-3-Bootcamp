{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name":"Python Debugger: Current File with Arguments",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal",
            "args":"${command:pickArgs}"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "export_all_prompts",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/segittur_commons/scripts/prompt_migration.py",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.devcontainer/.env",
            "args": ["export", "--output-path", "initial_prompts.json"],
        },
        {
            "name": "export_some_prompts",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/segittur_commons/scripts/prompt_migration.py",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.devcontainer/.env",
            "args": ["export", "--output-path", "some_prompts.json", "--prompts-to-export", "${command:pickArgs}"],
        },
        {
            "name": "import_all_prompts",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/segittur_commons/scripts/prompt_migration.py",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.devcontainer/.env",
            "args": ["import", "--input-path", "initial_prompts.json"],
        },
        {
            "name": "import_some_prompts",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/segittur_commons/scripts/prompt_migration.py",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.devcontainer/.env",
            "args": ["import", "--input-path", "initial_prompts.json", "--prompts-to-import", "${command:pickArgs}"],
        }
    ]
}